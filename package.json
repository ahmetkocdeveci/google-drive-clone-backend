{
  "name": "google-drive-clone-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.16.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "test:load": "node scripts/load-local.mjs",
    "check": "node scripts/check.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "worker": "node src/worker-entry.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "archiver": "8.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongoose": "9.11.2",
    "nodemailer": "10.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": { "supertest": "7.2.2" }
}
