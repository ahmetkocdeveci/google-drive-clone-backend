NODE_ENV=development
HOST=127.0.0.1
PORT=4100
API_ORIGIN=http://127.0.0.1:4100
FRONTEND_ORIGIN=http://127.0.0.1:4179
# Leave empty for direct local access. Production: only actual reverse-proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
MONGODB_URI=mongodb://127.0.0.1:27018/ortak_drive?replicaSet=rs0&directConnection=true
# npm run setup generates independent random 32-byte hex secrets.
OUTBOX_ENCRYPTION_KEY=
UPLOAD_SIGNING_KEY=
PAGINATION_SIGNING_KEY=
OPERATIONS_TOKEN=
# Store this separately from backups. Losing it makes encrypted backups unrecoverable.
BACKUP_ENCRYPTION_KEY=
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/objects
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ortak Drive <noreply@ortak-drive.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: STORAGE_DRIVER=s3, HTTPS origins and private S3-compatible bucket.
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
